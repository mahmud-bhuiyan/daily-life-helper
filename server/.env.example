# Neon PostgreSQL (use pooled connection string)
# Neon: use the *pooled* connection string. uselibpqcompat avoids pg 8.x sslmode warnings.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&uselibpqcompat=true

# development = local Neon/pg IPv4 workaround in db.ts; set production on Vercel
APP_ENV=development
PORT=4000

# JWT session (min 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# First migrate only — omit when DB already has users (e.g. live Neon)
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=change-me-on-first-run
# SUPER_ADMIN_NAME=Super Admin

# Comma-separated browser origins for CORS (credentials + httpOnly cookies)
# Dev:
CLIENT_URL=http://localhost:5173
# Prod example (add preview URLs as needed):
# CLIENT_URL=https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
