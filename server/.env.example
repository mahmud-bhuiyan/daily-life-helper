# Neon PostgreSQL (use pooled connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Server
PORT=4000

# JWT session (min 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# First migrate only — omit when DB already has users (e.g. live Neon)
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=change-me-on-first-run
# SUPER_ADMIN_NAME=Super Admin

# Client origin for CORS (dev)
CLIENT_URL=http://localhost:5173
